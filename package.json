{
  "name": "jsonrpc4js",
  "version": "1.2.0",
  "author": "Shing Rui <sunquakes@outlook.com>",
  "description": "A javascript client and server over http or tcp implementation of JSON-RPC 2.0.",
  "main": "dist/bundle.cjs",
  "module": "dist/bundle.mjs",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/bundle.mjs",
      "require": "./dist/bundle.cjs"
    }
  },
  "scripts": {
    "test": "jest",
    "build": "rollup -c"
  },
  "keywords": [
    "typescript",
    "jsonrpc2.0",
    "nodejs",
    "microservice",
    "nacos",
    "consul"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^22.20.5",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "rollup": "^4.6.1",
    "tslib": "^2.9.1",
    "typescript": "^5.2.2"
  }
}
